<mxfile host="app.diagrams.net" modified="2026-03-28" agent="CMU-VLN" version="24.0">
  <diagram name="Projector Dataflow" id="fig6">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Auxiliary Projectors: Data Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="400" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Five projection modules bridge between raw robot I/O and the Transformer embedding spaces" style="text;html=1;align=center;fontSize=10;fontColor=#6D6E71;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="600" height="18" as="geometry"/>
        </mxCell>

        <!-- ==================== INPUT SIDE ==================== -->
        <!-- state input -->
        <mxCell id="state_in" value="&lt;b&gt;obs.state&lt;/b&gt;&lt;br&gt;[B, 32]&lt;br&gt;&lt;i&gt;joint angles,&lt;br&gt;gripper pos&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D6E71;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="110" height="65" as="geometry"/>
        </mxCell>

        <!-- noisy actions input -->
        <mxCell id="act_in" value="&lt;b&gt;x&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt; (noisy actions)&lt;br&gt;[B, 50, 32]&lt;br&gt;&lt;i&gt;current trajectory&lt;br&gt;being denoised&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D6E71;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="110" height="65" as="geometry"/>
        </mxCell>

        <!-- timestep input -->
