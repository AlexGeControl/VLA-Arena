        <mxCell id="rules_title" value="&lt;b&gt;Attention Rules&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="465" width="200" height="22" as="geometry"/>
