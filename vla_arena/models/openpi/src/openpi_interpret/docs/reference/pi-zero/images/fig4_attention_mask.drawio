        <mxCell id="rule1_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D682E;strokeColor=#1A4A1C;" vertex="1" parent="1">
          <mxGeometry x="120" y="497" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="rule1" value="&lt;b&gt;Rule 1 — Prefix is bidirectional:&lt;/b&gt; All 816 image + language tokens attend freely to each other.&lt;br&gt;This enables rich cross-modal visual-language understanding within Expert 0." style="text;html=1;align=left;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="490" width="520" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rule2_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C41230;strokeColor=#8B0D21;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="rule2" value="&lt;b&gt;Rule 2 — Prefix cannot see suffix:&lt;/b&gt; Vision-language context is computed independently.&lt;br&gt;This enables KV cache reuse — prefix is processed once and cached during inference." style="text;html=1;align=left;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="523" width="520" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rule3_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D682E;strokeColor=#1A4A1C;" vertex="1" parent="1">
          <mxGeometry x="120" y="563" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="rule3" value="&lt;b&gt;Rule 3 — Action tokens see everything:&lt;/b&gt; They attend to all prefix tokens (images, language),&lt;br&gt;the state token, and each other. This is how the action expert conditions on VL context." style="text;html=1;align=left;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="556" width="520" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rule4_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C99700;strokeColor=#8B6800;" vertex="1" parent="1">
          <mxGeometry x="120" y="596" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="rule4" value="&lt;b&gt;Rule 4 — State sees prefix, not actions:&lt;/b&gt; The state token reads the VL context but forms&lt;br&gt;a one-way boundary — it is a &quot;grounding anchor&quot; but does not attend to future actions." style="text;html=1;align=left;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="589" width="520" height="30" as="geometry"/>
        </mxCell>

