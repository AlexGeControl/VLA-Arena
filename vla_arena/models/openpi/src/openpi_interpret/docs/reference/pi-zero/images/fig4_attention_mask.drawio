        <mxCell id="ar_mask_text" value="&lt;b&gt;Implementation:&lt;/b&gt; ar_mask = [False×816, True, True, False×49] → cumulative sum → prefix-LM pattern" style="text;html=1;align=center;fontSize=9;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
