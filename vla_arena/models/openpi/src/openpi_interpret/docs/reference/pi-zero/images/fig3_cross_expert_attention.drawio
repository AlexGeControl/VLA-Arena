        <mxCell id="p2_note" value="&lt;i&gt;Concatenate Q/K/V along sequence axis,&lt;br&gt;apply ONE softmax over all 867 tokens&lt;/i&gt;" style="text;html=1;align=center;fontSize=9;fontColor=#006666;fontFamily=Helvetica;" vertex="1" parent="1">
