        <mxCell id="summary_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="75" width="350" height="590" as="geometry"/>
        </mxCell>
        <mxCell id="summary_title" value="&lt;b&gt;Key Design Principle&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="82" width="330" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="summary_text" value="The two experts have &lt;b&gt;different widths&lt;/b&gt;&lt;br&gt;(2048 vs 1024) but &lt;b&gt;identical head&lt;br&gt;configurations&lt;/b&gt;:&lt;br&gt;&lt;br&gt;• 8 query heads&lt;br&gt;• 1 KV head (GQA)&lt;br&gt;• head_dim = 256&lt;br&gt;&lt;br&gt;This enables the &lt;b&gt;project → fuse →&lt;br&gt;split&lt;/b&gt; pattern:&lt;br&gt;&lt;br&gt;1. Each expert independently maps&lt;br&gt;   from its width to &lt;b&gt;head space&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. Q, K, V are concatenated in&lt;br&gt;   head space — same dim everywhere&lt;br&gt;&lt;br&gt;3. One unified softmax lets action&lt;br&gt;   tokens attend to VL tokens&lt;br&gt;&lt;br&gt;4. Output is split and projected&lt;br&gt;   back to each expert's own width&lt;br&gt;&lt;br&gt;This is why &lt;b&gt;cross-modal attention&lt;br&gt;works despite different widths.&lt;/b&gt;" style="text;html=1;align=left;fontSize=11;fontColor=#333333;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="315" height="380" as="geometry"/>
        </mxCell>

        <!-- Dimension flow diagram in summary -->
        <mxCell id="dim_flow_title" value="&lt;b&gt;Dimension Flow&lt;/b&gt;" style="text;html=1;align=center;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="840" y="500" width="310" height="18" as="geometry"/>
        </mxCell>
