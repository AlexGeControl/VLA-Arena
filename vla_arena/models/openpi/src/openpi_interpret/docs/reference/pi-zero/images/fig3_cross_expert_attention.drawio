        <mxCell id="p1_label" value="&lt;b&gt;Phase 1: Per-Expert Q/K/V Projection&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
