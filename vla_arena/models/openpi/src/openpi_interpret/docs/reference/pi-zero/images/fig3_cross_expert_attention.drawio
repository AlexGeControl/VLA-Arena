        <!-- Concatenated Q/K/V -->
        <mxCell id="cat_qkv" value="&lt;b&gt;Concatenate along sequence axis&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q = [Q₀ | Q₁] → [B, &lt;b&gt;867&lt;/b&gt;, 8, 256]&lt;br&gt;K = [K₀ | K₁] → [B, &lt;b&gt;867&lt;/b&gt;, 1, 256]&lt;br&gt;V = [V₀ | V₁] → [B, &lt;b&gt;867&lt;/b&gt;, 1, 256]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E0E0;strokeColor=#008B8B;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- RoPE + scale -->
        <mxCell id="rope_box" value="Apply &lt;b&gt;RoPE&lt;/b&gt; to Q, K&lt;br&gt;Scale Q by √head_dim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008B8B;fontColor=#FFFFFF;strokeColor=#006666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="155" height="40" as="geometry"/>
        </mxCell>

        <!-- Softmax -->
        <mxCell id="softmax_box" value="&lt;b&gt;Unified Softmax&lt;/b&gt;&lt;br&gt;logits = Q · K&lt;sup&gt;T&lt;/sup&gt;&lt;br&gt;[B, 1, 8, &lt;b&gt;867, 867&lt;/b&gt;]&lt;br&gt;+ attention mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008B8B;fontColor=#FFFFFF;strokeColor=#006666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="230" width="150" height="65" as="geometry"/>
        </mxCell>

