        <mxCell id="subtitle" value="How tokens from Expert 0 (width=2048) and Expert 1 (width=1024) interact through shared head space (head_dim=256)" style="text;html=1;align=center;fontSize=10;fontColor=#6D6E71;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
